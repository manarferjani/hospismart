{% extends 'front.html.twig' %}

{% block title %}Stock Médicaments - Hospismart OASIS{% endblock %}

{% block body %}
    <div class="text-center mb-5 animate-fade-up">
        <h1 class="display-4 fw-bold text-dark mb-3" style="letter-spacing: -1px;">
            <i class="fa-solid fa-prescription-bottle-medical text-primary me-2 opacity-75"></i>Stocks Pharmaceutiques
        </h1>
        <p class="lead text-muted mx-auto" style="max-width: 600px;">Consultez la disponibilité de nos médicaments en temps réel avec notre interface intelligente OASIS.</p>
    </div>

    {# Barre de Recherche et Filtres Premium #}
    <div class="row justify-content-center mb-5 animate-fade-up" style="animation-delay: 0.1s;">
        <div class="col-lg-10">
            <div class="premium-card p-2 glass-effect shadow-sm">
                <div class="row g-2 align-items-center">
                    <div class="col-md-6 border-end border-opacity-10 divider-mobile-none">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-0 ps-3"><i class="fa-solid fa-search text-primary opacity-50"></i></span>
                            <input type="text" id="searchInput" class="form-control border-0 shadow-none bg-transparent fs-5" placeholder="Rechercher un médicament..." style="height: 50px;">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-0 ps-3"><i class="fa-solid fa-filter text-muted small"></i></span>
                            <select id="categoryFilter" class="form-select border-0 shadow-none bg-transparent fw-medium">
                                <option value="">Toutes les catégories</option>
                                {% for category in categories %}
                                    <option value="{{ category.id }}">{{ category.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2 text-center border-start border-opacity-10 divider-mobile-none">
                        <span class="text-muted small fw-bold text-uppercase d-block" style="letter-spacing: 1px;">Résultats</span>
                        <span id="countMed" class="text-primary fw-bold fs-5">{{ medicaments|length }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Grille des Médicaments Premium #}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="medGrid">
        {% for medicament in medicaments %}
            <div class="col med-item animate-fade-up" data-name="{{ medicament.nom|lower }}" data-category="{{ medicament.categorie ? medicament.categorie.id : '' }}" style="animation-delay: {{ 0.1 + (loop.index0 * 0.05) }}s;">
                <div class="premium-card h-100 p-0 overflow-hidden">
                    <div class="p-4">
                        {# Badge Statut Raffiné #}
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="rounded-xl bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; border: 1px solid rgba(99, 102, 241, 0.1);">
                                {% if medicament.imageFilename %}
                                    <img src="{{ asset('uploads/medicaments/' ~ medicament.imageFilename) }}" alt="{{ medicament.nom }}" class="w-100 h-100 object-fit-cover rounded-xl shadow-sm">
                                {% else %}
                                    <i class="fa-solid fa-pills text-primary fs-4"></i>
                                {% endif %}
                            </div>
                            
                            {% if medicament.quantite <= medicament.seuilAlerte %}
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-10 rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-fire-flame-curved me-1"></i>Critique
                                </span>
                            {% elseif medicament.quantite < medicament.seuilAlerte * 2 %}
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-10 rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-clock me-1"></i>Faible
                                </span>
                            {% else %}
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-10 rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-check-double me-1"></i>Disponible
                                </span>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            <h5 class="fw-bold text-dark mb-1 fs-4">{{ medicament.nom }}</h5>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small d-flex align-items-center">
                                    <i class="fa-solid fa-tag me-1 opacity-50"></i>
                                    {{ medicament.categorie ? medicament.categorie.nom : 'Non classé' }}
                                </span>
                                <span class="text-muted opacity-25">|</span>
                                <span class="text-muted small">REF-{{ medicament.id|format("%04d") }}</span>
                            </div>
                        </div>

                        <div class="glass-effect rounded-lg p-3 d-flex justify-content-between align-items-center border-0" style="background: rgba(248, 250, 252, 0.8);">
                            <div>
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">Quantité</small>
                                <span class="fs-4 fw-bold {{ medicament.quantite <= medicament.seuilAlerte ? 'text-danger' : 'text-primary' }}">{{ medicament.quantite }}</span>
                                <small class="text-muted ms-1">unités</small>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">Prix Unitaire</small>
                                <span class="fs-4 fw-bold text-dark">{{ medicament.prixUnitaire|number_format(2, ',', ' ') }}<small class="fs-6 ms-1">€</small></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="px-4 pb-4 mt-2">
                        <div class="d-flex justify-content-between align-items-center py-3 border-top border-opacity-10">
                            <div class="d-flex align-items-center text-muted small">
                                <i class="fa-regular fa-calendar-check me-2 text-primary opacity-50"></i>
                                <span>Exp: <strong>{{ medicament.datePeremption|date('M Y') }}</strong></span>
                            </div>
                            <a href="{{ path('app_stock_public_show', {id: medicament.id}) }}" class="btn btn-sm btn-light border py-2 px-3 fw-bold text-primary text-decoration-none">
                                Détails <i class="fa-solid fa-arrow-right ms-1 small"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5 glass-effect rounded-xl">
                <div class="mb-3 opacity-25">
                    <i class="fa-solid fa-box-open fa-4x text-muted"></i>
                </div>
                <h4 class="text-muted fw-bold">Aucun médicament disponible.</h4>
                <p class="text-muted">Veuillez revenir plus tard ou contacter l'administration.</p>
            </div>
        {% endfor %}
    </div>

    {# Empty State Premium (Affiché par le JS) #}
    <div id="noResults" class="text-center py-5 glass-effect rounded-xl d-none animate-fade-up">
        <div class="mb-4 opacity-50">
            <i class="fa-solid fa-magnifying-glass fa-4x text-primary"></i>
        </div>
        <h4 class="text-dark fw-bold">Aucun résultat trouvé</h4>
        <p class="text-muted">Essayez d'ajuster vos critères de recherche ou la catégorie.</p>
        <button class="btn btn-primary rounded-pill px-4" onclick="resetFilters()">
            Réinitialiser les filtres
        </button>
    </div>

    {# Style spécifique additionnel #}
    <style>
        .rounded-xl { border-radius: 1.25rem; }
        .rounded-lg { border-radius: 1rem; }
        @media (max-width: 767.98px) {
            .divider-mobile-none { border: none !important; }
        }
    </style>
{% endblock %}

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const items = document.querySelectorAll('.med-item');
        const noResults = document.getElementById('noResults');
        const countMed = document.getElementById('countMed');

        function filterItems() {
            const searchTerm = searchInput.value.toLowerCase();
            const categoryId = categoryFilter.value;
            let visibleCount = 0;

            items.forEach(item => {
                const name = item.dataset.name;
                const category = item.dataset.category;
                
                const matchesSearch = name.includes(searchTerm);
                const matchesCategory = categoryId === '' || category === categoryId;

                if (matchesSearch && matchesCategory) {
                    item.classList.remove('d-none');
                    visibleCount++;
                } else {
                    item.classList.add('d-none');
                }
            });

            countMed.textContent = visibleCount;
            
            if (visibleCount === 0) {
                noResults.classList.remove('d-none');
            } else {
                noResults.classList.add('d-none');
            }
        }

        searchInput.addEventListener('input', filterItems);
        categoryFilter.addEventListener('change', filterItems);
        
        window.resetFilters = function() {
            searchInput.value = '';
            categoryFilter.value = '';
            filterItems();
        }
    });
</script>
{% endblock %}
