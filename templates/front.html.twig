{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    .navbar-glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        position: sticky;
        top: 0;
        z-index: 1000;
        transition: all 0.3s ease;
    }
    
    .nav-link {
        font-weight: 600;
        color: var(--text-main) !important;
        padding: 0.5rem 1rem !important;
        border-radius: var(--radius-sm);
        transition: all 0.2s ease;
    }
    
    .nav-link:hover {
        background: rgba(99, 102, 241, 0.05);
        color: var(--primary) !important;
    }
    
    .nav-link.active {
        color: var(--primary) !important;
        background: rgba(99, 102, 241, 0.1);
    }

    .brand-logo {
        background: linear-gradient(135deg, var(--primary), var(--primary-hover));
        color: white !important;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .btn-admin {
        background: white;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 0.5rem 1.2rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-admin:hover {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        box-shadow: var(--shadow-sm);
    }

    .front-main {
        min-height: 75vh;
        padding-top: 2rem;
    }

    .footer-premium {
        background: white;
        border-top: 1px solid var(--border-color);
        padding: 4rem 0 2rem;
        margin-top: 5rem;
    }

    .hero-gradient {
        background: radial-gradient(circle at top right, rgba(99, 102, 241, 0.05) 0%, transparent 40%);
        min-height: 100vh;
    }
</style>
{% endblock %}

{% block layout %}
<div class="hero-gradient">
    <nav class="navbar navbar-expand-lg navbar-glass py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_stock_public') }}">
                <div class="brand-logo">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
                <div>
                    <span class="fw-bold text-dark fs-4">HospiSmart</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-10 ms-1" style="font-size: 10px;">OASIS</span>
                </div>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_stock_public' ? 'active' : '' }}" href="{{ path('app_stock_public') }}">
                            <i class="fa-solid fa-capsules me-1 small opacity-50"></i> Médicaments
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <a href="{{ path('app_dashboard') }}" class="btn-admin text-decoration-none d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-shield small"></i>
                        Espace Pro
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container front-main">
        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} border-0 shadow-sm mb-4 animate-fade-up" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid {{ label == 'error' ? 'fa-circle-xmark' : 'fa-circle-check' }}"></i>
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="footer-premium">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <div class="d-flex align-items-center gap-2 mb-2 justify-content-center justify-content-md-start">
                        <div class="brand-logo" style="width:30px; height:30px; font-size:12px;">HS</div>
                        <span class="fw-bold text-dark">HospiSmart OASIS</span>
                    </div>
                    <p class="text-muted small mb-0">Outil d'Assistance et de Suivi Intelligent de Santé</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="text-muted small mb-0">&copy; {{ 'now'|date('Y') }} HospiSmart. Tous droits réservés.</p>
                    <div class="mt-2">
                        <span class="badge bg-light text-muted border fw-normal">Version 2.4.0 Premium</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

