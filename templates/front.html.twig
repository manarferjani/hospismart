{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/front.css') }}">
<style>
    :root {
        --primary-color: #0d6efd;
        --hover-color: #4178F5;
    }
    .navbar { background: transparent !important; padding: 20px 0; }
    
    /* Style des liens avec animation de soulignement */
    .nav-link { 
        color: #555 !important; 
        font-weight: 500; 
        margin: 0 10px; 
        transition: all 0.3s ease;
        border-bottom: 2px solid transparent;
    }

    .nav-link:hover { 
        color: var(--hover-color) !important; 
        transform: translateY(-2px);
    }

    .nav-link.active { 
        color: var(--primary-color) !important; 
        font-weight: 700;
        border-bottom: 2px solid var(--primary-color);
    }

    .btn-logout { 
        background-color: white; color: var(--primary-color); 
        border: 2px solid var(--primary-color); border-radius: 50px; 
        padding: 8px 20px; font-weight: 600; text-decoration: none; transition: 0.3s;
    }
    .btn-logout:hover { background-color: var(--primary-color); color: white; }

    .notification-bell { color: #555; transition: color 0.3s ease; cursor: pointer; }
    .notification-bell:hover { color: var(--primary-color); }
    
    .dropdown-menu { border-radius: 15px; border: none; }
    .footer-oasis { border-top: 1px solid #dee2e6; padding: 2rem 0; margin-top: 3rem; color: #6c757d; font-size: 0.875rem; }
</style>
{% endblock %}

{% block layout %}
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="{{ path('app_home') }}">
                <div class="bg-primary text-white rounded-3 p-2 me-3 d-inline-flex shadow-sm">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
                <strong>Hospismart</strong>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    {# On affiche ce lien uniquement si l'utilisateur est un patient #}
                    {% if app.user and is_granted('ROLE_USER') and not is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.get('_route') == 'app_medecin_recherche' ? 'active' : '' }}" href="{{ path('app_medecin_recherche') }}">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.get('_route') == 'app_mes_rendezvous' ? 'active' : '' }}" href="{{ path('app_mes_rendezvous') }}">Mes rendez-vous</a>
                        </li>
                    {% endif %}
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') in ['app_evenement_public', 'app_evenement_inscription'] ? 'active' : '' }}" href="{{ path('app_evenement_public') }}">Événements</a>
                    </li>
                    {# Lien "Mes Événements" visible uniquement pour les utilisateurs connectés #}
                    {% if app.user %}
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.get('_route') == 'app_mes_evenements' ? 'active' : '' }}" href="{{ path('app_mes_evenements') }}">Mes Événements</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.get('_route') == 'front_office_mes_reclamations' ? 'active' : '' }}" href="{{ path('front_office_mes_reclamations') }}">Mes réclamations</a>
                        </li>
                    {% endif %}
                    {# Ce lien s'affiche pour l'admin OU pour un utilisateur identifié comme médecin #}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MEDECIN') %}
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.get('_route') == 'app_stock_public' ? 'active' : '' }}" href="{{ path('app_stock_public') }}">Stocks médicaments</a>
                        </li>
                    {% endif %}
                    {% if app.user %}

                    {% endif %}
                </ul>
            </div>

        <div class="d-flex align-items-center">
            {# 1. Système de Notification (Visible par tous les utilisateurs connectés) #}
            {% if app.user %}
                <div class="dropdown me-3" data-turbo="false">
                    <a class="nav-link p-0 position-relative notification-bell" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                        <i class="fa-solid fa-bell fs-5"></i>
                        
                        {# Calcul des non lues - Utilisation de isRead() de l'entité #}
                        {% set unread_count = 0 %}
                        {% for notif in app.user.notifications %}
                            {% if not notif.isRead %}{% set unread_count = unread_count + 1 %}{% endif %}
                        {% endfor %}
                        
                        {% if unread_count > 0 %}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                {{ unread_count }}
                            </span>
                        {% endif %}
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow mt-3" style="width: 300px; border-radius: 12px;">
                        <li class="dropdown-header border-bottom pb-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Notifications</span>
                            {% if unread_count > 0 %}
                                <span class="badge bg-primary text-white">{{ unread_count }}</span>
                            {% endif %}
                        </li>
                        
                        <div style="max-height: 300px; overflow-y: auto;">
                            {% if app.user.notifications is not empty %}
                                {% for notif in app.user.notifications|sort((a, b) => b.createdAt <=> a.createdAt)|slice(0, 5) %}
                                    <li class="p-3 border-bottom {{ not notif.isRead ? 'bg-light' : '' }}">
                                        <small class="d-block {{ not notif.isRead ? 'fw-bold text-dark' : 'text-muted' }}" style="line-height: 1.2;">
                                            {{ notif.content }}
                                        </small>
                                        <small class="text-muted mt-1 d-block" style="font-size: 0.65rem;">
                                            <i class="fa-regular fa-clock me-1"></i>{{ notif.createdAt|date('d/m H:i') }}
                                        </small>
                                    </li>
                                {% endfor %}
                            {% else %}
                                <li class="p-4 text-center text-muted small">Aucune notification</li>
                            {% endif %}
                        </div>
                    </ul>
                </div>
            {% endif %}

            {# 2. Menu Utilisateur (Déconnexion / Mon Compte) #}
            <div class="d-none d-lg-block">
                {% if app.user %}
                    <div class="dropdown d-inline-block" data-turbo="false">
                        <a class="btn-logout dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ app.user.prenom }}
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow mt-2" style="border-radius: 12px;">
                            <li>
                                <a class="dropdown-item small" href="{{ path('app_patient_coordonnees') }}">
                                    <i class="fa-solid fa-user-circle me-2 text-primary"></i>Mon Compte
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item small text-danger" href="{{ path('app_logout') }}">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i>Déconnexion
                                </a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_login') }}" class="btn-logout">Connexion</a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary px-4 shadow-sm" style="border-radius: 50px; font-weight: 600;">
                            <i class="fa-solid fa-user-plus me-2"></i>Inscription
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
        </div>
    </nav>

    <main class="container py-4">
        {# Flash Messages Unifiés #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show shadow-sm" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>
    <footer class="footer-oasis text-center">
        <div class="container">
            <p class="mb-1">Hospismart &copy; {{ 'now'|date('Y') }} - OASIS</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const notifDropdown = document.getElementById('notifDropdown');
            if (notifDropdown) {
                notifDropdown.addEventListener('click', function() {
                    const badge = notifDropdown.querySelector('.badge');
                    if (badge) {
                        badge.style.display = 'none'; // Cacher le badge
                    }
                    
                    const unreadItems = document.querySelectorAll('.dropdown-menu .bg-light');
                    unreadItems.forEach(item => {
                        item.classList.remove('bg-light');
                        const textElement = item.querySelector('.fw-bold');
                        if (textElement) {
                            textElement.classList.remove('fw-bold', 'text-dark');
                            textElement.classList.add('text-muted');
                        }
                    });

                    fetch('{{ path('app_notifications_mark_read') }}', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    }).catch(error => console.error('Erreur lors du marquage des notifications:', error));
                }, { once: true });
            }
        });
    </script>
{% endblock %}