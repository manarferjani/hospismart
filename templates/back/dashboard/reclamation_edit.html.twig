{% extends 'back.html.twig' %}

{% block title %}Traiter Réclamation #{{ reclamation.id }}{% endblock %}

{% block content %}
<div class="back-page-header">
    <h1 class="back-page-title">✏️ Traiter la réclamation #{{ reclamation.id }}</h1>
    <a href="{{ path('app_dashboard_reclamations') }}" class="btn" style="background:#64748b;color:white;">← Annuler</a>
</div>

<div class="row">
    {# ====== COLONNE GAUCHE : Détails de la réclamation ====== #}
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm border-0" style="border-radius:15px;">
            <div class="card-header bg-dark text-white" style="border-radius:15px 15px 0 0;">
                <h5 class="mb-0"><i class="fa-solid fa-file-lines me-2"></i>Réclamation #{{ reclamation.id }}</h5>
            </div>
            <div class="card-body p-4">
                <h4 class="mb-3 text-primary">{{ reclamation.titre }}</h4>
                <div class="mb-3">
                    <span class="badge {{ reclamation.statut == 'Traité' ? 'bg-success' : (reclamation.statut == 'En cours' ? 'bg-primary' : 'bg-warning text-dark') }} me-2" style="font-size:0.85rem;">
                        {{ reclamation.statut }}
                    </span>
                    <span class="badge {{ reclamation.priorite == 'Urgente' ? 'bg-danger' : (reclamation.priorite == 'Haute' ? 'bg-warning text-dark' : (reclamation.priorite == 'Normale' ? 'bg-info' : 'bg-secondary')) }}" style="font-size:0.85rem;">
                        {{ reclamation.priorite }}
                    </span>
                </div>
                <hr>
                <p><strong><i class="fa-solid fa-user me-1"></i> Patient :</strong> {{ reclamation.nomPatient }}</p>
                <p><strong><i class="fa-solid fa-envelope me-1"></i> Email :</strong> <a href="mailto:{{ reclamation.email }}">{{ reclamation.email }}</a></p>
                <p><strong><i class="fa-solid fa-tag me-1"></i> Catégorie :</strong> {{ reclamation.categorie ?? 'Non spécifiée' }}</p>
                <p><strong><i class="fa-regular fa-clock me-1"></i> Date :</strong> {{ reclamation.dateCreation|date('d/m/Y à H:i') }}</p>
                <hr>
                <h6 class="text-muted">Description</h6>
                <div class="bg-light p-3 rounded" style="max-height:200px; overflow-y:auto;">{{ reclamation.description|nl2br }}</div>
            </div>
        </div>

        {# ====== CARTE ÉTAT MENTAL & CONSEILS DE COMMUNICATION ====== #}
        {% if reclamation.etatMental %}
        {% set etatRaw = reclamation.etatMental %}
        {% set etatLabel = etatRaw starts with 'Calme' ? 'Calme' : 
                          (etatRaw starts with 'Frustré' ? 'Frustré' : 
                          (etatRaw starts with 'En colère' ? 'En colère' : 
                          (etatRaw starts with 'Anxieux' ? 'Anxieux' : 
                          (etatRaw starts with 'Triste' ? 'Triste' : 
                          (etatRaw starts with 'Satisfait' ? 'Satisfait' : etatRaw))))) %}
        {% set etatEmoji = etatLabel == 'Calme' ? '😌' : 
                          (etatLabel == 'Frustré' ? '😤' : 
                          (etatLabel == 'En colère' ? '😡' : 
                          (etatLabel == 'Anxieux' ? '😰' : 
                          (etatLabel == 'Triste' ? '😢' : 
                          (etatLabel == 'Satisfait' ? '😊' : '❓'))))) %}
        {% set etatColor = etatLabel == 'Calme' ? '#28a745' : 
                          (etatLabel == 'Frustré' ? '#fd7e14' : 
                          (etatLabel == 'En colère' ? '#dc3545' : 
                          (etatLabel == 'Anxieux' ? '#ffc107' : 
                          (etatLabel == 'Triste' ? '#6f42c1' : 
                          (etatLabel == 'Satisfait' ? '#20c997' : '#6c757d'))))) %}
        {% set etatBg = etatLabel == 'Calme' ? '#dcfce7' : 
                       (etatLabel == 'Frustré' ? '#fff7ed' : 
                       (etatLabel == 'En colère' ? '#fef2f2' : 
                       (etatLabel == 'Anxieux' ? '#fefce8' : 
                       (etatLabel == 'Triste' ? '#f5f3ff' : 
                       (etatLabel == 'Satisfait' ? '#ecfdf5' : '#f1f5f9'))))) %}
        
        {# Communication advice based on mental state #}
        {% set conseilCom = etatLabel == 'Calme' ? 'Le patient est serein. Vous pouvez communiquer normalement avec un ton professionnel et bienveillant.' : 
                           (etatLabel == 'Frustré' ? 'Le patient montre de la frustration. Adoptez une écoute active, reconnaissez son mécontentement et proposez des solutions concrètes. Évitez les réponses génériques.' : 
                           (etatLabel == 'En colère' ? '⚠️ Le patient est très mécontent ! Restez calme, présentez des excuses sincères, montrez que vous prenez sa plainte au sérieux. Proposez un suivi personnalisé et une résolution rapide.' : 
                           (etatLabel == 'Anxieux' ? 'Le patient est inquiet ou stressé. Rassurez-le avec des informations claires et précises. Expliquez chaque étape du processus de traitement de sa réclamation. Proposez un point de contact direct.' : 
                           (etatLabel == 'Triste' ? 'Le patient semble abattu ou découragé. Faites preuve de compassion et d\'empathie. Montrez que son bien-être est votre priorité. Offrez un soutien moral et des actions concrètes.' : 
                           (etatLabel == 'Satisfait' ? 'Le patient est satisfait. Remerciez-le pour son retour positif et assurez un suivi pour maintenir cette satisfaction.' : 'Aucune analyse disponible.'))))) %}
        
        {# Extract detailed explanation from etatRaw (after the " — ") #}
        {% set explicationDetail = '' %}
        {% if ' — ' in etatRaw %}
            {% set explicationDetail = etatRaw|split(' — ', 2)[1]|default('') %}
        {% endif %}

        <div class="card shadow-sm border-0 mt-4" style="border-radius:15px; border-left: 5px solid {{ etatColor }} !important;">
            <div class="card-header text-white d-flex align-items-center gap-2" style="background: {{ etatColor }}; border-radius:15px 15px 0 0;">
                <span style="font-size:1.5rem;">🧠</span>
                <h5 class="mb-0">Analyse IA — État Mental du Patient</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span style="font-size:2.5rem;">{{ etatEmoji }}</span>
                    <div>
                        <h4 class="mb-0" style="color: {{ etatColor }};">{{ etatLabel }}</h4>
                        <small class="text-muted">Détecté par l'IA du chatbot</small>
                    </div>
                </div>
                
                {% if explicationDetail %}
                <div class="p-3 rounded mb-3" style="background: {{ etatBg }}; border-left: 4px solid {{ etatColor }};">
                    <strong><i class="fa-solid fa-magnifying-glass-chart me-1"></i> Analyse détaillée :</strong>
                    <p class="mb-0 mt-1">{{ explicationDetail }}</p>
                </div>
                {% endif %}

                <div class="p-3 rounded" style="background: #f0f9ff; border-left: 4px solid #3b82f6;">
                    <strong><i class="fa-solid fa-comments me-1"></i> 💡 Conseil de communication :</strong>
                    <p class="mb-0 mt-1">{{ conseilCom }}</p>
                </div>
            </div>
        </div>
        {% endif %}

        {# ====== Mise à jour statut / priorité ====== #}
        <div class="card shadow-sm border-0 mt-4" style="border-radius:15px;">
            <div class="card-header" style="background:#475569; color:white; border-radius:15px 15px 0 0;">
                <h5 class="mb-0"><i class="fa-solid fa-sliders me-2"></i>Modifier statut & priorité</h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" name="action" value="update_status">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Statut</label>
                            <select name="statut" class="form-select">
                                <option value="En attente" {{ reclamation.statut == 'En attente' ? 'selected' : '' }}>En attente</option>
                                <option value="En cours" {{ reclamation.statut == 'En cours' ? 'selected' : '' }}>En cours</option>
                                <option value="Traité" {{ reclamation.statut == 'Traité' ? 'selected' : '' }}>Traité</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Priorité</label>
                            <select name="priorite" class="form-select">
                                <option value="Basse" {{ reclamation.priorite == 'Basse' ? 'selected' : '' }}>Basse</option>
                                <option value="Normale" {{ reclamation.priorite == 'Normale' ? 'selected' : '' }}>Normale</option>
                                <option value="Haute" {{ reclamation.priorite == 'Haute' ? 'selected' : '' }}>Haute</option>
                                <option value="Urgente" {{ reclamation.priorite == 'Urgente' ? 'selected' : '' }}>Urgente</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-warning text-white fw-bold px-4">
                            <i class="fa-solid fa-save me-2"></i>Mettre à jour
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# ====== COLONNE DROITE : Réponses + formulaire ====== #}
    <div class="col-lg-6 mb-4">
        {# ====== Historique des réponses ====== #}
        {% if reclamation.reponses|length > 0 %}
        <div class="card shadow-sm border-0 mb-4" style="border-radius:15px;">
            <div class="card-header bg-info text-white" style="border-radius:15px 15px 0 0;">
                <h5 class="mb-0"><i class="fa-solid fa-comments me-2"></i>Réponses ({{ reclamation.reponses|length }})</h5>
            </div>
            <div class="card-body p-4" style="max-height:350px; overflow-y:auto;">
                {% for reponse in reclamation.reponses %}
                <div class="mb-3 p-3 rounded" style="background: #f0fdf4; border-left: 4px solid #22c55e;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-success">
                            <i class="fa-solid fa-user-shield me-1"></i>{{ reponse.adminNom }}
                        </strong>
                        <small class="text-muted">
                            <i class="fa-regular fa-clock me-1"></i>{{ reponse.dateReponse|date('d/m/Y à H:i') }}
                        </small>
                    </div>
                    <p class="mb-1">{{ reponse.contenu|nl2br }}</p>
                    <small class="text-muted"><i class="fa-solid fa-envelope me-1"></i>{{ reponse.adminEmail }}</small>
                </div>
                {% if not loop.last %}<hr class="my-2">{% endif %}
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# ====== Formulaire de réponse ====== #}
        <div class="card shadow-sm border-0" style="border-radius:15px;">
            <div class="card-header bg-success text-white" style="border-radius:15px 15px 0 0;">
                <h5 class="mb-0"><i class="fa-solid fa-reply me-2"></i>Répondre à la réclamation</h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" name="action" value="repondre">
                    <div class="mb-3">
                        <label for="admin_nom" class="form-label fw-bold">Votre nom</label>
                        <input type="text" name="admin_nom" id="admin_nom" class="form-control" 
                               value="{{ app.user ? app.user.nom ~ ' ' ~ app.user.prenom : '' }}" 
                               placeholder="Nom de l'administrateur" required minlength="2">
                    </div>
                    <div class="mb-3">
                        <label for="admin_email" class="form-label fw-bold">Votre email</label>
                        <input type="email" name="admin_email" id="admin_email" class="form-control" 
                               value="{{ app.user ? app.user.email : '' }}" 
                               placeholder="admin@hospismart.local" required>
                    </div>
                    <div class="mb-3">
                        <label for="contenu" class="form-label fw-bold">Votre réponse</label>
                        <textarea name="contenu" id="contenu" class="form-control" rows="5" 
                                  placeholder="Rédigez votre réponse au patient..." required minlength="10"></textarea>
                        <div class="form-text">Minimum 10 caractères</div>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100">
                        <i class="fa-solid fa-paper-plane me-2"></i>Envoyer la réponse
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
