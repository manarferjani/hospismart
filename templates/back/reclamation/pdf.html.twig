<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Réclamations</title>
    <style>
        body { font-family: sans-serif; font-size: 12px; }
        h1 { text-align: center; color: #333; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; font-weight: bold; }
        .badge { padding: 3px 6px; border-radius: 4px; color: white; display: inline-block; }
        .bg-urgent { background-color: #dc3545; }
        .bg-haute { background-color: #ffc107; color: #000; }
        .bg-normale { background-color: #17a2b8; }
        .bg-traite { background-color: #28a745; }
    </style>
</head>
<body>
    <h1>Rapport des Réclamations - Hospismart</h1>
    <p>Date de l'export : {{ "now"|date("d/m/Y H:i") }}</p>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Titre</th>
                <th>Patient</th>
                <th>Catégorie</th>
                <th>Priorité</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for rec in reclamations %}
            <tr>
                <td>{{ rec.dateCreation|date('d/m/Y') }}</td>
                <td>{{ rec.titre }}</td>
                <td>{{ rec.nomPatient }}</td>
                <td>{{ rec.categorie }}</td>
                <td>
                    {% if rec.priorite == 'Urgente' %}<span class="badge bg-urgent">Urgente</span>
                    {% elseif rec.priorite == 'Haute' %}<span class="badge bg-haute">Haute</span>
                    {% else %}<span class="badge bg-normale">{{ rec.priorite }}</span>{% endif %}
                </td>
                <td>{{ rec.statut }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
