{% extends 'front.html.twig' %}

{% block title %}Mot de passe oublié - HospiSmart{% endblock %}

{% block body %}
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm border-0 p-4" style="max-width: 450px; border-radius: 25px; background-color: #f0f7ff;">
        
        <div class="text-center mb-4">
            {# Icône Cadenas Bleue comme sur la page login #}
            <div class="mb-3">
                <i class="fa-solid fa-lock text-primary" style="font-size: 3rem;"></i>
            </div>
            <h2 class="fw-bold h4" style="color: #1a1a2e;">Mot de passe oublié ?</h2>
            <p class="text-muted small px-3">
                Entrez votre adresse email et nous vous enverrons un lien pour réinitialiser votre accès.
            </p>
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                <div class="small">{{ flash_error }}</div>
            </div>
        {% endfor %}

        {{ form_start(requestForm, {'attr': {'class': 'px-3'}}) }}
            <div class="mb-4">
                <label class="form-label fw-bold small mb-2">Adresse Email</label>
                {{ form_widget(requestForm.email, {
                    'attr': {
                        'class': 'form-control border-0 py-3 shadow-sm',
                        'placeholder': 'votre@email.com',
                        'style': 'border-radius: 12px;'
                    }
                }) }}
                {% if form_errors(requestForm.email) %}
                    <div class="text-danger small mt-2">{{ form_errors(requestForm.email) }}</div>
                {% endif %}
            </div>

            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm" style="border-radius: 12px; background: linear-gradient(45deg, #0d6efd, #0046ad); border: none;">
                ENVOYER LE LIEN
            </button>
        {{ form_end(requestForm) }}

        <div class="text-center mt-4">
            <a href="{{ path('app_login') }}" class="text-decoration-none small fw-bold text-primary">
                <i class="fa-solid fa-arrow-left me-1"></i> Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}