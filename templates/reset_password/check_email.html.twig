{% extends 'front.html.twig' %}

{% block title %}Vérifiez vos emails - HospiSmart{% endblock %}

{% block body %}
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm border-0 p-5 text-center" style="max-width: 500px; border-radius: 25px; background-color: #f0f7ff;">
        
        <div class="mb-4">
            {# Icône enveloppe avec un badge de succès #}
            <div class="position-relative d-inline-block">
                <i class="fa-solid fa-envelope-open-text text-primary" style="font-size: 4rem;"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-success p-2">
                    <i class="fa-solid fa-check text-white" style="font-size: 1rem;"></i>
                </span>
            </div>
            <h2 class="fw-bold h4 mt-4" style="color: #1a1a2e;">Vérifiez vos emails</h2>
        </div>

        <p class="text-muted mb-4" style="font-size: 1rem; line-height: 1.6;">
            Un email contenant un lien de réinitialisation vous a été envoyé. 
            <br>
            <span class="badge bg-soft-primary text-primary mt-2 p-2" style="background-color: #dbeafe;">
                <i class="fa-regular fa-clock me-1"></i>
                Expire dans : {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}
            </span>
        </p>

        <div class="p-3 mb-4" style="background-color: #ffffff; border-radius: 15px; border: 1px dashed #cbd5e1;">
            <p class="small text-muted mb-0">
                <i class="fa-solid fa-circle-info me-2 text-info"></i>
                Si vous ne recevez rien, vérifiez votre dossier <strong>"Spam"</strong> ou essayez une autre adresse.
            </p>
        </div>

        <div class="d-grid gap-2">
            <a href="{{ path('app_login') }}" class="btn btn-primary py-3 fw-bold shadow-sm" style="border-radius: 12px; background: linear-gradient(45deg, #0d6efd, #0046ad); border: none;">
                RETOUR À LA CONNEXION
            </a>
            <a href="{{ path('app_forgot_password_request') }}" class="btn btn-link btn-sm text-decoration-none text-muted mt-2">
                Renvoyer l'email
            </a>
        </div>
    </div>
</div>
{% endblock %}