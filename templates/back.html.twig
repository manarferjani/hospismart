{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    :root {
        --primary-color: #0d6efd;
        --dark-sidebar: #1e293b;
        --success-color: #198754;
    }
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background-color: #f8fafc; 
    }

    .admin-wrapper { 
        display: flex; 
        min-height: 100vh; 
        background: #f8fafc;
    }
    
    .sidebar {
        width: 280px;
        background: var(--dark-sidebar);
        color: white;
        padding: 30px 20px;
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        z-index: 1001;
        flex-shrink: 0;
        overflow-y: auto;
    }

    .sidebar-brand { font-size: 22px; font-weight: 700; margin-bottom: 30px; display: flex; align-items: center; color: white; text-decoration: none; }
    .sidebar-brand i { color: var(--primary-color); margin-right: 15px; }

    .role-badge {
        font-size: 10px;
        background: rgba(255,255,255,0.1);
        padding: 2px 8px;
        border-radius: 10px;
        text-transform: uppercase;
        margin-left: 10px;
        color: var(--primary-color);
    }

    /* Profil Sidebar */
    .sidebar-profile {
        text-align: center;
        padding: 15px 10px 25px 10px;
        margin-bottom: 25px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        display: block; 
        text-decoration: none;
        transition: 0.3s;
        border-radius: 15px;
    }
    .sidebar-profile:hover { background: rgba(255, 255, 255, 0.05); }
    .sidebar-profile.active-profile { background: rgba(13, 110, 253, 0.1); border-bottom: 1px solid var(--primary-color); }

    .profile-img {
        width: 70px; height: 70px;
        border-radius: 50%;
        border: 3px solid rgba(255,255,255,0.1);
        margin-bottom: 10px;
        object-fit: cover;
    }
    .profile-name { font-size: 15px; font-weight: 600; display: block; color: #fff; }
    .profile-spec { font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; display: block; }

    .sidebar-menu { list-style: none; padding: 0; flex-grow: 1; }
    .sidebar-menu li { margin-bottom: 5px; }
    .sidebar-menu a {
        color: rgba(255,255,255,0.7);
        text-decoration: none;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        border-radius: 12px;
        transition: 0.3s;
    }
    .sidebar-menu a:hover, .sidebar-menu a.active {
        background: rgba(13, 110, 253, 0.15);
        color: white;
        font-weight: 600;
    }
    .sidebar-menu i { width: 25px; margin-right: 10px; font-size: 18px; text-align: center; }

    .main-content { 
        flex: 1; 
        padding: 40px; 
        background: #f8fafc; 
        min-width: 0;
        position: relative;
    }

    .menu-header { font-size: 11px; text-transform: uppercase; color: rgba(255,255,255,0.3); margin: 20px 0 10px 15px; letter-spacing: 1px; }
    .logout-box { margin-top: auto; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; }

    /* Notifications */
    .notif-container { position: absolute; top: 40px; right: 40px; z-index: 1000; }
    .notification-bell { color: #555; cursor: pointer; position: relative; }
    .bell-badge {
        position: absolute;
        top: -2px;
        right: -2px;
        background-color: #dc3545;
        color: white;
        border-radius: 50%; /* Assure la rondeur */
        width: 18px;        /* Largeur fixe */
        height: 18px;       /* Hauteur fixe égale à la largeur */
        font-size: 10px;
        font-weight: bold;
        display: flex;      /* Aligne le chiffre au centre */
        align-items: center;
        justify-content: center;
        border: 2px solid #f8fafc; /* Optionnel : ajoute un petit contour pour le détacher du fond */
    }
    .notif-dropdown {
        position: absolute; right: 0; top: 45px; width: 300px;
        background: white; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        display: none; border: 1px solid #eee;
    }
    .notif-dropdown.active { display: block; }

    @media (max-width: 992px) {
        .admin-wrapper { flex-direction: column; }
        .sidebar { width: 100%; height: auto; position: relative; }
        .notif-container { top: 15px; right: 15px; }
    }
    .sidebar-menu .badge.rounded-pill {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;         /* Enlève le padding qui déforme le cercle */
    font-size: 11px;
}

    .anim-pulse {
        animation: pulse-red 2s infinite;
    }
    @keyframes pulse-red {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
</style>
{% endblock %}

{% block layout %}
<div class="admin-wrapper">
<aside class="sidebar">

    {# ===== BRAND COMBINÉ ===== #}
    <a href="{{ path('app_dashboard') }}" class="sidebar-brand mb-4">
        <i class="fa-solid fa-heart-pulse fa-lg text-primary"></i> 
        <span class="ms-2">HospiSmart</span>

        {# Badge rôle #}
        <span class="role-badge ms-2">
            {% if is_granted('ROLE_ADMIN') %}Admin
            {% elseif is_granted('ROLE_MEDECIN') %}Médecin
            {% else %}Staff{% endif %}
        </span>

        {# Badge Premium de l’autre branche #}
        <span class="badge bg-primary-subtle text-primary ms-auto"
              style="font-size:10px;border:1px solid rgba(99,102,241,0.2);">
            PREMIUM
        </span>
    </a>

    {# ===== PROFIL DYNAMIQUE ===== #}
    {% if is_granted('ROLE_MEDECIN') %}
        <a href="{{ path('app_medecin_profil') }}"
           class="sidebar-profile {{ app.request.get('_route') == 'app_medecin_profil' ? 'active-profile' : '' }}">
            <img src="{{ app.user.image ? asset('/images/' ~ (app.user.type|lower == 'medecin' ? 'medecins/' : 'patients/') ~ app.user.image) : 'https://ui-avatars.com/api/?name=' ~ app.user.nom ~ '+' ~ app.user.prenom ~ '&background=0d6efd&color=fff' }}"
                 class="profile-img shadow-sm">
            <span class="profile-name">Dr. {{ app.user.nom }}</span>
            <span class="profile-spec">{{ app.user.specialite|default('Médecin') }}</span>
        </a>
    {% elseif is_granted('ROLE_ADMIN') %}
        <div class="sidebar-profile">
            <img src="https://ui-avatars.com/api/?name={{ app.user.nom }}+{{ app.user.prenom }}&background=1e293b&color=fff"
                 class="profile-img">
            <span class="profile-name">{{ app.user.nom }} {{ app.user.prenom }}</span>
            <span class="profile-spec">Administrateur</span>
        </div>
    {% endif %}

    <nav class="sidebar-nav">
        <ul class="sidebar-menu">

            {# ===== OVERVIEW (nouvelle branche) ===== #}
            <div class="menu-header">Overview</div>
            <li>
                <a href="{{ path('app_dashboard') }}"
                   class="{{ app.request.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                    <i class="fa-solid fa-grid-2 me-2"></i> Dashboard
                </a>
            </li>

            {# ===== ADMIN ===== #}
            {% if is_granted('ROLE_ADMIN') %}
                <div class="menu-header">Administration</div>

                <li><a href="{{ path('app_dashboard_utilisateurs_list') }}">
                    <i class="fa-solid fa-users"></i> Utilisateurs
                </a></li>

                <li><a href="{{ path('app_dashboard_reclamations') }}">
                    <i class="fa-solid fa-circle-exclamation"></i> Réclamations
                </a></li>

                <div class="menu-header">Inventory</div>

                <li><a href="{{ path('app_medicament_index') }}">
                    <i class="fa-solid fa-pills"></i> Médicaments
                </a></li>

                <li><a href="{{ path('app_categorie_index') }}">
                    <i class="fa-solid fa-tags"></i> Catégories
                </a></li>

                <li><a href="{{ path('app_mouvement_stock_index') }}">
                    <i class="fa-solid fa-clock-rotate-left"></i> Historique
                </a></li>
            {% endif %}

            {# ===== MÉDECIN ===== #}
            {% if is_granted('ROLE_MEDECIN') %}
                <div class="menu-header">Ma Clinique</div>

                <li><a href="{{ path('app_medecin_dashboard') }}">
                    <i class="fa-solid fa-chart-pie"></i> Dashboard
                </a></li>

                <li><a href="{{ path('app_medecin_demandes_rdv') }}">
                    <i class="fa-solid fa-calendar-check"></i> Mes RDV
                </a></li>

                <li><a href="{{ path('app_medecin_dispo_index') }}">
                    <i class="fa-solid fa-clock"></i> Mes Créneaux
                </a></li>

                <li><a href="{{ path('app_medecin_patients') }}">
                    <i class="fa-solid fa-hospital-user"></i> Mes Patients
                </a></li>
            {% endif %}

            {# ===== ÉVÉNEMENTS COMMUN ===== #}
            <div class="menu-header">Événements</div>
            <li>
                <a href="{{ path('app_evenement_index') }}">
                    <i class="fa-solid fa-calendar-days"></i> Événements
                </a>
            </li>

        </ul>
    </nav>

    {# ===== FOOTER / LOGOUT COMBINÉ ===== #}
    <div class="logout-box mt-auto">
        <ul class="sidebar-menu">

            <li><a href="{{ path('app_home') }}" class="text-info">
                <i class="fa-solid fa-globe"></i> Voir le site
            </a></li>

            <li><a href="{{ path('app_stock_public') }}" class="text-light opacity-75">
                <i class="fa-solid fa-arrow-up-right-from-square me-2"></i> Live Portal
            </a></li>

            <li><a href="{{ path('app_logout') }}" class="text-danger">
                <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
            </a></li>

        </ul>
    </div>

</aside>

    <main class="main-content">
        {# Barre de notifications (si médecin) #}
        {% if is_granted('ROLE_MEDECIN') and app.request.get('_route') == 'app_medecin_dashboard' %}
            <div class="notif-container">
                <div class="notification-bell" id="bellBtn">
                    <i class="fa-solid fa-bell fa-xl"></i>
                    {% if unread_notifications_count is defined and unread_notifications_count > 0 %}
                        <span class="bell-badge">{{ unread_notifications_count }}</span>
                    {% endif %}
                </div>
                <div class="notif-dropdown" id="notifBox">
                    <div class="p-3 border-bottom fw-bold">Demandes en attente</div>
                    <div class="notif-body">
                        {% if notifications_list is defined and notifications_list|length > 0 %}
                            {% for rdv in notifications_list %}
                                <a href="{{ path('app_medecin_demandes_rdv') }}" class="text-decoration-none text-dark">
                                    <div class="p-2 border-bottom small">
                                        <strong>{{ rdv.patient.nom }}</strong><br>
                                        <span class="text-muted">Le {{ rdv.datetime|date('d/m à H:i') }}</span>
                                    </div>
                                </a>
                            {% endfor %}
                        {% else %}
                            <div class="p-3 text-center text-muted small">Aucune notification</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} alert-dismissible fade show shadow-sm border-0">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
        {% block body %}{% endblock %}
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const bell = document.getElementById('bellBtn');
        const box = document.getElementById('notifBox');
        if (bell && box) {
            bell.addEventListener('click', (e) => {
                e.stopPropagation();
                box.classList.toggle('active');
            });
            document.addEventListener('click', () => box.classList.remove('active'));
        }
    });
</script>
{% endblock %}