{% extends 'front.html.twig' %}

{% block title %}Inscription - {{ evenement.titre }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% if evenement.latitude and evenement.longitude %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
    #inscription-map {
        width: 100%;
        height: 280px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 1rem;
    }
    .map-section-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #3b82f6;
        margin-bottom: 8px;
    }
</style>
{% endif %}
{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h4 mb-2"><i class="fa-solid fa-user-plus text-primary"></i> Inscription à l'événement</h2>
                <p class="text-muted mb-4">
                    <strong>{{ evenement.titre }}</strong><br>
                    <small>
                        <i class="fa-solid fa-calendar"></i> {{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y H:i') : '' }} 
                        | <i class="fa-solid fa-location-dot"></i> {{ evenement.lieu }}
                    </small>
                </p>

                {# ── Map: show event location ── #}
                {% if evenement.latitude and evenement.longitude %}
                <div class="mb-4">
                    <div class="map-section-label">
                        <i class="fa-solid fa-map-location-dot me-1"></i> Localisation de l'événement
                    </div>
                    <div id="inscription-map"></div>
                </div>
                {% endif %}

                {# ── Weather Forecast ── #}
                {% if weather is defined and weather %}
                <div class="mb-4">
                    <div class="card border-0" style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-radius: 12px;">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fa-solid fa-cloud-sun text-primary me-2"></i>
                                <span style="font-size: 0.95rem; font-weight: 600; color: #0369a1;">Prévisions météo</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                {% if weather.condition_icon %}
                                    <img src="https:{{ weather.condition_icon }}" alt="{{ weather.condition_text }}" style="width: 50px; height: 50px;">
                                {% endif %}
                                <div>
                                    <div style="font-size: 1.4rem; font-weight: 700; color: #1e293b;">{{ weather.temp_c }}°C</div>
                                    <div style="font-size: 0.85rem; color: #475569;">{{ weather.condition_text }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                {% if user_connected is defined and user_connected %}
                    <p class="alert alert-light border mb-3" style="font-size: 0.9rem;">
                        <i class="fa-solid fa-user-check text-success"></i> Connecté en tant que : <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong>
                    </p>
                {% endif %}

                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    
                    {% if user_connected is not defined or not user_connected %}
                        {{ form_row(form.nom) }}
                        {{ form_row(form.prenom) }}
                        {{ form_row(form.email) }}
                    {% endif %}
                    
                    {{ form_row(form.telephone) }}
                    {{ form_row(form.role) }}
                    
                    <div class="mb-4">
                        <div class="form-check">
                            {{ form_widget(form.confirme_presence) }}
                            {{ form_label(form.confirme_presence) }}
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa-solid fa-check"></i> Confirmer l'inscription
                        </button>
                        <a href="{{ path('app_evenement_public') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

{# ── Leaflet JS: render the map ── #}
{% if evenement.latitude and evenement.longitude %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const lat = {{ evenement.latitude }};
    const lng = {{ evenement.longitude }};

    const map = L.map('inscription-map', {
        zoomControl: true,
        scrollWheelZoom: false
    }).setView([lat, lng], 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    L.marker([lat, lng]).addTo(map)
        .bindPopup('<b>📍 {{ evenement.lieu | e('js') }}</b>').openPopup();

    setTimeout(function() { map.invalidateSize(); }, 300);
});
</script>
{% endif %}
{% endblock %}