{% extends 'front.html.twig' %}

{% block title %}Mes Événements - Hospismart{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .event-card { transition: transform 0.3s, box-shadow 0.3s; margin-bottom: 2rem; }
    .event-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
    .badge-inscrit { background: linear-gradient(135deg, #10b981, #059669); color: white; font-weight: 600; }
</style>
{% endblock %}

{% block body %}
<div class="text-center mb-5">
    <h1 class="display-6"><i class="fa-solid fa-calendar-check text-success"></i> Mes Événements</h1>
    <p class="lead text-muted">Les événements auxquels vous êtes inscrit</p>
</div>

{% if evenements|length > 0 %}
    <div class="row g-4">
        {% for evenement in evenements %}
            {% set participation = participations|filter(p => p.evenement.id == evenement.id)|first %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 event-card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">{{ evenement.titre }}</h5>
                            <span class="badge badge-inscrit">
                                <i class="fa-solid fa-check-circle"></i> Inscrit
                            </span>
                        </div>

                        <p class="text-muted small mb-2"><i class="fa-solid fa-tag"></i> {{ evenement.typeEvenement|capitalize }}</p>
                        
                        {% if evenement.statut == 'planifié' %}
                            <span class="badge bg-warning text-dark mb-2">Planifié</span>
                        {% elseif evenement.statut == 'en_cours' %}
                            <span class="badge bg-primary mb-2">En cours</span>
                        {% elseif evenement.statut == 'terminé' %}
                            <span class="badge bg-success mb-2">Terminé</span>
                        {% endif %}
                        
                        <p class="card-text small">{{ evenement.description|slice(0, 100) }}{% if evenement.description|length > 100 %}...{% endif %}</p>
                        <hr>
                        
                        <p class="mb-1 small"><i class="fa-solid fa-calendar text-primary"></i> <strong>Début:</strong> {{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y H:i') : '—' }}</p>
                        <p class="mb-1 small"><i class="fa-solid fa-calendar-check text-success"></i> <strong>Fin:</strong> {{ evenement.dateFin ? evenement.dateFin|date('d/m/Y H:i') : '—' }}</p>
                        <p class="mb-1 small"><i class="fa-solid fa-location-dot text-danger"></i> <strong>Lieu:</strong> {{ evenement.lieu }}</p>
                        
                        {% if evenement.budgetAlloue %}
                            <p class="mb-1 small"><i class="fa-solid fa-coins text-info"></i> <strong>Budget:</strong> {{ evenement.budgetAlloue }} TND</p>
                        {% endif %}
                        
                        <p class="mb-2 small"><i class="fa-solid fa-users text-secondary"></i> <strong>Participants:</strong> {{ evenement.participants|length }}</p>

                        {% if participation %}
                            <p class="mb-3 small text-muted">
                                <i class="fa-solid fa-clock"></i> Inscrit le {{ participation.dateInscription ? participation.dateInscription|date('d/m/Y H:i') : '—' }}
                            </p>
                        {% endif %}

                        {% if weatherData[evenement.id] is defined and weatherData[evenement.id] %}
                            {% set w = weatherData[evenement.id] %}
                            <div class="d-flex align-items-center gap-2 mb-3 p-2" style="background: linear-gradient(135deg, #e0f2fe, #f0f9ff); border-radius: 8px; font-size: 0.85rem;">
                                {% if w.condition_icon %}
                                    <img src="https:{{ w.condition_icon }}" alt="{{ w.condition_text }}" style="width: 36px; height: 36px;">
                                {% endif %}
                                <div>
                                    <span style="font-weight: 700; color: #1e293b;">{{ w.temp_c }}°C</span>
                                    <span class="text-muted ms-1">{{ w.condition_text }}</span>
                                </div>
                                {% if w.chance_of_rain is not null and w.chance_of_rain > 0 %}
                                    <span class="ms-auto text-muted" title="Risque de pluie"><i class="fa-solid fa-umbrella"></i> {{ w.chance_of_rain }}%</span>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="d-flex gap-2">
                            <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-outline-primary flex-grow-1">
                                <i class="fa-solid fa-eye"></i> Détails
                            </a>
                            {% if participation %}
                                <form method="post" action="{{ path('app_evenement_desinscription', {'id': participation.id}) }}" class="flex-grow-1" onsubmit="return confirm('Êtes-vous sûr de vouloir vous désinscrire ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ participation.id) }}">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="fa-solid fa-user-minus"></i> Se désinscrire
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="alert alert-info text-center py-5 shadow-sm" style="border-radius: 15px;">
        <i class="fa-solid fa-calendar-xmark fa-3x mb-3 text-info"></i>
        <h4>Vous n'êtes inscrit à aucun événement</h4>
        <p class="mb-3">Découvrez les événements à venir et inscrivez-vous !</p>
        <a href="{{ path('app_evenement_public') }}" class="btn btn-primary">
            <i class="fa-solid fa-calendar-days"></i> Voir les événements disponibles
        </a>
    </div>
{% endif %}
{% endblock %}
