{% extends 'front.html.twig' %}

{% block title %}Authentification à deux facteurs - HospiSmart{% endblock %}

{% block layout %}
<div class="front-form-box" style="max-width: 450px; text-align: center; padding: 3rem 2.5rem;">
    
    <div class="two-factor-icon">
        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
    </div>

    <h2>Vérification Sécurisée</h2>

    {% for message in app.flashes('error') %}
        <div style="background-color: #fee2e2; color: #b91c1c; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.95rem;">
            {{ message }}
        </div>
    {% endfor %}
    
    {% for message in app.flashes('success') %}
        <div style="background-color: #d1fae5; color: #047857; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.95rem;">
            {{ message }}
        </div>
    {% endfor %}

    {% if is_setup %}
        <div style="margin-bottom: 2rem;">
            <p style="font-size: 1rem; color: var(--front-text-muted); line-height: 1.6;">
                Pour protéger vos données de santé, l'activation du 2FA est obligatoire.<br><br>
                Scannez ce QR Code avec <strong>Google Authenticator</strong>.
            </p>
            <div style="margin: 1.5rem 0; display:flex; justify-content:center;">
                <img src="{{ qr_code }}" alt="QR Code 2FA" style="width: 220px; border: 1px solid var(--front-card-border); padding: 10px; border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm);">
            </div>
            <p style="font-size: 0.85rem; color: var(--front-text-muted); word-break: break-all;">
                Clé manuelle : <strong>{{ secret }}</strong>
            </p>
        </div>
    {% else %}
        <p style="font-size: 1.05rem; color: var(--front-text-muted); margin-bottom: 2rem;">
            Veuillez entrer le code à 6 chiffres généré par votre application d'authentification.
        </p>
    {% endif %}

    <form method="post" action="{{ path('app_2fa') }}">
        <div class="form-group" style="margin-bottom: 1.5rem;">
            <input type="text" id="auth_code" name="auth_code" class="two-factor-input" required autofocus 
                   autocomplete="off" pattern="[0-9]{6}" maxlength="6"
                   placeholder="------">
        </div>
        
        <button type="submit" class="btn-primary" style="padding: 1rem;">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            Valider mon accès
        </button>
    </form>
    
    <div style="margin-top: 1.5rem;">
        <a href="{{ path('app_logout') }}" style="color: var(--front-text-muted); text-decoration: none; font-size: 0.95rem; font-weight: 500;">
            ← Annuler et revenir en arrière
        </a>
    </div>
</div>
{% endblock %}
