{% extends 'front.html.twig' %}

{% block body %}
<div class="container py-5 text-center">
    <div class="mb-4">
        <i class="fa-solid fa-circle-check text-success fa-4x"></i>
        <h2 class="mt-3 fw-bold">Consultation enregistrée avec succès !</h2>
        <p class="text-muted">Le dossier de <strong>{{ consultation.patient.prenom }} {{ consultation.patient.nom }}</strong> a été mis à jour.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 mb-4" style="border-radius: 20px;">
                <h5>Actions disponibles</h5>
                <hr>
                <div class="d-grid gap-3">
                    {# Bouton pour générer/voir le PDF #}
                    <a href="{{ path('app_consultation_pdf', {'id': consultation.id}) }}" class="btn btn-dark btn-lg" target="_blank">
                        <i class="fa-solid fa-file-pdf me-2"></i> Imprimer l'ordonnance
                    </a>
                    
                    {# NOUVEAU : Bouton pour envoyer par Email #}
                    <a href="{{ path('app_medecin_envoyer_ordonnance', {'id': consultation.id}) }}" class="btn btn-success btn-lg">
                        <i class="fa-solid fa-envelope-dark me-2"></i> Envoyer au patient par Email
                    </a>

                    <hr>

                    <a href="{{ path('app_medecin_dashboard') }}" class="btn btn-outline-primary">
                        <i class="fa-solid fa-house me-2"></i> Retour au tableau de bord
                    </a>
                </div>
            </div>
            
            {# Petit message d'info pour rassurer le médecin #}
            <small class="text-muted">
                <i class="fa-solid fa-info-circle me-1"></i> 
                L'email sera envoyé à : <strong>{{ consultation.patient.email }}</strong>
            </small>
        </div>
    </div>
</div>
{% endblock %}