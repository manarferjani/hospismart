{% extends 'back.html.twig' %}

{% block title %}
    Mon Profil - Dr. {{ app.user ? app.user.nom : 'Médecin' }}
{% endblock %}

{% block body %}
<div class="container-fluid">
    <h2 class="fw-bold mb-4" style="color: #1a1a2e;">Mon Profil Professionnel</h2>

    {% if app.user %}
        <div class="row">
            {# Colonne de gauche : Carte de visite #}
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 text-center p-4 mb-4" style="border-radius: 20px;">
                    <div class="mb-3">
                        {% if app.user.image %}
                            <img src="{{ asset('/images/medecins/' ~ app.user.image) }}" 
                                 class="rounded-circle shadow-sm" style="width: 128px; height: 128px; object-fit: cover;" alt="Avatar">
                        {% else %}
                            <img src="https://ui-avatars.com/api/?name={{ app.user.nom|url_encode }}+{{ app.user.prenom|url_encode }}&size=128&background=0D6EFD&color=fff" 
                                 class="rounded-circle shadow-sm" alt="Avatar">
                        {% endif %}
                    </div>
                    <h4 class="fw-bold">Dr. {{ app.user.prenom }} {{ app.user.nom }}</h4>
                    <p class="text-muted small">Médecin inscrit sur Hospismart</p>
                    <hr>
                    <div class="text-start small">
                        <p class="mb-2"><i class="fa-solid fa-envelope me-2 text-primary"></i> {{ app.user.email }}</p>
                        <p class="mb-0"><i class="fa-solid fa-id-card me-2 text-primary"></i> 
                            Spécialité : {{ app.user.specialite|default('Généraliste') }}
                        </p>
                    </div>
                </div>
            </div>

            {# Colonne de droite : Formulaire de mise à jour #}
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 p-4" style="border-radius: 20px;">
                    <h5 class="fw-bold mb-4">Modifier mes informations</h5>
                    
                    {# Utilisation de path('app_medecin_profil_update') (à créer dans votre contrôleur) #}
                    <form action="{{ path('app_medecin_profil_update') }}" method="POST">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nom</label>
                                <input type="text" name="nom" class="form-control rounded-3" value="{{ app.user.nom }}" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Prénom</label>
                                <input type="text" name="prenom" class="form-control rounded-3" value="{{ app.user.prenom }}" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Email professionnel</label>
                                <input type="email" name="email" class="form-control rounded-3" value="{{ app.user.email }}" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Téléphone</label>
                                <input type="tel" name="telephone" class="form-control rounded-3" value="{{ app.user.telephone|default('') }}" placeholder="Ex: +216 00 000 000">
                            </div>
                            
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary px-4 shadow-sm" style="border-radius: 10px;">
                                    <i class="fa-solid fa-save me-2"></i>Enregistrer les modifications
                                </button>
                                <a href="{{ path('app_medecin_dashboard') }}" class="btn btn-light px-4 ms-2" style="border-radius: 10px;">Annuler</a>
                            </div>
                        </div>
                    </form>
                </div>
                
                {# Optionnel : Changement de mot de passe #}
                {# Section Sécurité corrigée #}
                <div class="card shadow-sm border-0 p-4 mt-4" style="border-radius: 20px; background-color: #f8f9fa;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h6 class="fw-bold mb-1">Sécurité du compte</h6>
                            <p class="text-muted small mb-0">Protégez votre accès avec un mot de passe robuste.</p>
                        </div>
<a href="{{ path('app_forgot_password_request') }}" 
   class="btn btn-outline-primary rounded-pill px-4 text-nowrap">
    <i class="fa-solid fa-key me-2"></i>Changer le mot de passe
</a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-danger shadow-sm border-0" style="border-radius: 12px;">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            <strong>Accès refusé :</strong> Vous devez être connecté pour voir cette page. 
            <a href="{{ path('app_login') }}" class="alert-link">Se connecter</a>
        </div>
    {% endif %}
</div>
{% endblock %}