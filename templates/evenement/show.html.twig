{% extends 'back.html.twig' %}

{% block title %}Détails de l'Événement{% endblock %}
{% block page_title %}Détails de l'Événement{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ path('app_evenement_index') }}">Accueil</a></li>
<li class="breadcrumb-item"><a href="{{ path('app_evenement_index') }}">Événements</a></li>
<li class="breadcrumb-item active">Détails</li>
{% endblock %}

{% block body %}
{% if evenement.latitude and evenement.longitude %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
{% endif %}
<style>
    #event-map-view { width:100%; height:350px; border-radius:12px; border:1px solid #e2e8f0; box-shadow:0 2px 8px rgba(0,0,0,0.1); margin-top:10px; }
    .map-section-title { font-size:1rem; font-weight:700; color:#3b82f6; margin-bottom:6px; margin-top:24px; }
</style>
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ evenement.titre }}</h3>
                <div class="card-tools">
                    <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tbody>
                        <tr><th>Id</th><td>{{ evenement.id }}</td></tr>
                        <tr><th>Titre</th><td>{{ evenement.titre }}</td></tr>
                        <tr><th>Description</th><td>{{ evenement.description }}</td></tr>
                        <tr><th>Type</th><td><span class="badge bg-info">{{ evenement.typeEvenement }}</span></td></tr>
                        <tr><th>Date de début</th><td>{{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y H:i') : '' }}</td></tr>
                        <tr><th>Date de fin</th><td>{{ evenement.dateFin ? evenement.dateFin|date('d/m/Y H:i') : '' }}</td></tr>
                        <tr>
                            <th>Lieu</th>
                            <td>
                                <i class="fas fa-map-marker-alt text-danger me-1"></i>
                                {{ evenement.lieu }}
                                {% if evenement.latitude and evenement.longitude %}
                                    <small class="text-muted ms-2">({{ evenement.latitude|round(5) }}, {{ evenement.longitude|round(5) }})</small>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Statut</th>
                            <td>
                                {% if evenement.statut == 'planifié' %}<span class="badge bg-warning text-dark">{{ evenement.statut }}</span>
                                {% elseif evenement.statut == 'en_cours' %}<span class="badge bg-primary">{{ evenement.statut }}</span>
                                {% elseif evenement.statut == 'terminé' %}<span class="badge bg-success">{{ evenement.statut }}</span>
                                {% else %}<span class="badge bg-danger">{{ evenement.statut }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr><th>Budget alloué</th><td>{{ evenement.budgetAlloue ? evenement.budgetAlloue ~ ' TND' : '-' }}</td></tr>
                    </tbody>
                </table>

                {# ── Geoapify Map (only when coordinates saved) ── #}
                {% if evenement.latitude and evenement.longitude %}
                <div class="map-section-title"><i class="fas fa-map-location-dot me-2"></i>Localisation de l'événement</div>
                <div id="event-map-view"></div>
                {% endif %}

                <h4 class="mt-4">Participants ({{ evenement.participants|length }})</h4>
                {% if evenement.participants|length > 0 %}
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Participant</th><th>Rôle</th><th>Confirmation</th></tr>
                        </thead>
                        <tbody>
                            {% for participant in evenement.participants %}
                                <tr>
                                    <td>{{ participant.nomComplet }} <small class="text-muted">({{ participant.email }})</small></td>
                                    <td><span class="badge bg-secondary">{{ participant.role }}</span></td>
                                    <td>
                                        {% if participant.confirmePresence %}
                                            <span class="badge bg-success">Confirmé</span>
                                        {% else %}
                                            <span class="badge bg-warning text-dark">En attente</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="text-muted">Aucun participant pour cet événement.</p>
                {% endif %}
            </div>
            <div class="card-footer">
                <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                <form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" class="d-inline ms-2" onsubmit="return confirm('Supprimer cet événement et ses participants ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Supprimer l'événement
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{% if evenement.latitude and evenement.longitude %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const GEOAPIFY_KEY = '{{ google_maps_api_key }}';
const lat = {{ evenement.latitude }};
const lng = {{ evenement.longitude }};

const map = L.map('event-map-view', { zoomControl: true, scrollWheelZoom: false }).setView([lat, lng], 15);

L.tileLayer(
    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    { attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors', maxZoom: 19 }
).addTo(map);

setTimeout(() => map.invalidateSize(), 300);

const marker = L.marker([lat, lng]).addTo(map);
marker.bindPopup(`<b>📍 {{ evenement.lieu | e('js') }}</b>`).openPopup();
</script>
{% endif %}
{% endblock %}
