<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.demo.controller.PortalController" style="-fx-background-color: #f3f6fb;">
    <top>
        <HBox spacing="20" style="-fx-background-color: linear-gradient(to right, #1f3c88, #2d6cdf); -fx-padding: 16 20 16 20;">
            <VBox spacing="2">
                <Label text="HospiSmart - Portail" style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>
                <Label text="Choisissez l'interface à ouvrir" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 16px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 24;">
            <VBox spacing="12" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-padding: 20; -fx-background-radius: 12; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                <Label text="Front Office" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0b2a4a;"/>
                <Label text="Création, modification et suivi des réclamations." style="-fx-font-size: 16px; -fx-text-fill: #334155;" wrapText="true"/>
                <Button text="Ouvrir Front Office" onAction="#openFrontOffice" style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 18;"/>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-padding: 20; -fx-background-radius: 12; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                <Label text="Back Office" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0b2a4a;"/>
                <Label text="Dashboard administrateur et gestion des réponses." style="-fx-font-size: 16px; -fx-text-fill: #334155;" wrapText="true"/>
                <Button text="Ouvrir Back Office" onAction="#openBackOffice" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 18;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>


