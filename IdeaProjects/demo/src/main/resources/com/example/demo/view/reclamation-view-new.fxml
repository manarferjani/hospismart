<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.demo.controller.ReclamationControllerCRUD" stylesheets="@app.css">
    <top>
        <VBox spacing="15" styleClass="form-box">
            <Label text="Gestion des Réclamations" styleClass="page-title"/>
            <Label fx:id="statusLabel" styleClass="muted-label"/>

            <Separator/>
            <Label text="Ajouter / modifier une réclamation" styleClass="section-title"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="titreInput" promptText="Titre de la réclamation" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                <Label text="Patient:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="nomPatientInput" promptText="Nom du patient" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="200"/>

                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="emailInput" promptText="Email" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Catégorie:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <ComboBox fx:id="categorieCombo" promptText="Sélectionner..." GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="200"/>

                <Label text="Priorité:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="prioriteCombo" promptText="Sélectionner..." GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Statut:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <ComboBox fx:id="statutCombo" promptText="Sélectionner..." GridPane.rowIndex="2" GridPane.columnIndex="3" prefWidth="200"/>

                <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <TextArea fx:id="descriptionInput" promptText="Description détaillée" GridPane.rowIndex="3" GridPane.columnIndex="1"
                          GridPane.columnSpan="3" prefHeight="80" wrapText="true"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Ajouter / Enregistrer" onAction="#onAddReclamation" styleClass="action-button primary-button"/>
                <Button text="Réinitialiser" onAction="#onClearForm" styleClass="action-button secondary-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10" styleClass="card">
                <Button text="Actualiser" onAction="#loadReclamations" styleClass="action-button secondary-button"/>
                <Button text="Modifier sélection" onAction="#onEditReclamation" styleClass="action-button primary-button"/>
                <Button text="Supprimer sélection" onAction="#onDeleteReclamation" styleClass="action-button danger-button"/>
            </HBox>
            <TableView fx:id="reclamationTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="ID" prefWidth="0" fx:id="idColumn" visible="false"/>
                    <TableColumn text="Titre" prefWidth="150" fx:id="titreColumn"/>
                    <TableColumn text="Patient" prefWidth="120" fx:id="patientColumn"/>
                    <TableColumn text="Statut" prefWidth="100" fx:id="statutColumn"/>
                    <TableColumn text="Catégorie" prefWidth="120" fx:id="categorieColumn"/>
                    <TableColumn text="Priorité" prefWidth="80" fx:id="prioriteColumn"/>
                    <TableColumn text="Email" prefWidth="150" fx:id="emailColumn"/>
                    <TableColumn text="Date" prefWidth="140" fx:id="dateColumn"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>


