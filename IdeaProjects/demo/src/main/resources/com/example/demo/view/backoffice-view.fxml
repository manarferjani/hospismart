<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.demo.controller.BackOfficeController" stylesheets="@app.css">
    <top>
        <VBox spacing="0">
            <!-- En-tête principal -->
            <VBox spacing="8" styleClass="app-header">
                <Label text="Back Office - Gestion des Réponses" styleClass="app-title"/>
                <Label fx:id="statusLabel" styleClass="app-subtitle"/>
            </VBox>

            <!-- Barre de navigation avec actions principales -->
            <HBox spacing="10" styleClass="navbar-actions" style="-fx-padding: 10; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0; -fx-background-color: #f5f5f5;">
                <Label text="Actions rapides:" styleClass="section-title" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="📥 Enregistrer réponse" onAction="#onSendReponse" styleClass="action-button success-button"/>
                <Button text="🔄 Rafraîchir" onAction="#refreshSelectedReponses" styleClass="action-button secondary-button"/>
                <Button text="✏️ Modifier réponse" onAction="#onEditReponse" styleClass="action-button primary-button"/>
                <Button text="🗑️ Supprimer réponse" onAction="#onDeleteReponse" styleClass="action-button danger-button"/>
                <Button text="↻ Actualiser liste" onAction="#loadReclamations" styleClass="action-button secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.38">
            <VBox spacing="12" style="-fx-padding: 12;">
                <Label text="Réclamations" styleClass="section-title"/>
                <TableView fx:id="reclamationTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="ID" prefWidth="0" fx:id="idColumn" visible="false"/>
                        <TableColumn text="Titre" prefWidth="200" fx:id="titreColumn"/>
                        <TableColumn text="Patient" prefWidth="120" fx:id="patientColumn"/>
                        <TableColumn text="Statut" prefWidth="90" fx:id="statutColumn"/>
                        <TableColumn text="Réponses" prefWidth="80" fx:id="reponseCountColumn"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="12" style="-fx-padding: 12;">
                <VBox spacing="12" styleClass="card">
                    <Label text="Détails de la réclamation sélectionnée" styleClass="section-title"/>
                    <GridPane hgap="12" vgap="8">
                        <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="detailTitre" styleClass="muted-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Patient:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="detailPatient" styleClass="muted-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Statut:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="detailStatut" styleClass="muted-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Catégorie:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="detailCategorie" styleClass="muted-label" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Priorité:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="detailPriorite" styleClass="muted-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Label text="Description" styleClass="section-title"/>
                    <TextArea fx:id="detailDescription" wrapText="true" prefHeight="90" editable="false"/>
                </VBox>

                <VBox spacing="10" styleClass="card">
                    <Label text="Réponses de la réclamation" styleClass="section-title"/>
                    <TableView fx:id="responseTable" VBox.vgrow="ALWAYS" prefHeight="150">
                        <columns>
                            <TableColumn text="Date" prefWidth="150" fx:id="responseDateColumn"/>
                            <TableColumn text="Auteur" prefWidth="120" fx:id="responseAuteurColumn"/>
                            <TableColumn text="Statut" prefWidth="100" fx:id="responseStatutColumn"/>
                            <TableColumn text="Contenu" prefWidth="320" fx:id="responseContenuColumn"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10" styleClass="card">
                    <Label text="Ajouter / modifier une réponse" styleClass="section-title"/>
                    <HBox spacing="10">
                        <Label text="Auteur:"/>
                        <TextField fx:id="auteurInput" promptText="Nom de l'auteur" HBox.hgrow="ALWAYS"/>
                        <Label text="Statut:"/>
                        <ComboBox fx:id="statutReponseCombo" promptText="Statut" prefWidth="180"/>
                    </HBox>
                    <TextArea fx:id="reponseInput" promptText="Contenu de la réponse" prefHeight="80" wrapText="true" VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>






