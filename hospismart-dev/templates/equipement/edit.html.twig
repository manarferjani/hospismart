{% extends 'back.html.twig' %}

{% block title %}Modifier - {{ equipement.nom }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            {# Glass Card pour le formulaire #}
            <div class="glass-card shadow-lg p-4 p-md-5 border-0 position-relative overflow-hidden">
                
                {# Décoration de fond subtile #}
                <div class="position-absolute top-0 end-0 p-3 opacity-10">
                    <i class="fa-solid fa-microscope fa-6x text-primary"></i>
                </div>

                <div class="mb-4">
                    <a href="{{ path('app_equipement_index') }}" class="btn btn-sm btn-light rounded-pill px-3 mb-3">
                        <i class="fa-solid fa-arrow-left me-1"></i> Retour à l'inventaire
                    </a>
                    <h2 class="fw-bold text-dark mb-1">Modifier l'équipement</h2>
                    <p class="text-muted">Mettez à jour les informations de : <strong>{{ equipement.nom }}</strong></p>
                </div>

                <hr class="mb-4 opacity-10">

                {# On injecte le formulaire #}
                <div class="equipement-form">
                    {{ include('equipement/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>

                <div class="mt-4 pt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <p class="small text-muted mb-0">Zone de danger :</p>
                        {{ include('equipement/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .equipement-form form label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #495057;
    }
    .equipement-form input, 
    .equipement-form select, 
    .equipement-form textarea {
        border-radius: 12px !important;
        padding: 0.75rem 1rem;
        border: 1px solid #dee2e6;
        margin-bottom: 1rem;
        width: 100%;
        background: rgba(255, 255, 255, 0.9);
    }
    .equipement-form input:focus, 
    .equipement-form select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
        outline: none;
    }
    .equipement-form button.btn {
        width: 100%;
        padding: 0.8rem;
        font-weight: bold;
        border-radius: 50px;
        margin-top: 1rem;
        background: #0d6efd;
        border: none;
        color: white;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.2);
        transition: all 0.3s ease;
    }
    .equipement-form button.btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(13, 110, 253, 0.3);
        background: #0b5ed7;
    }
</style>
{% endblock %}
